# ─────────────────────────────────────────────
# SISO OcupaSalud — Variables de entorno
# Copia este archivo como .env y rellena los valores.
# NUNCA subas .env a GitHub.
# ─────────────────────────────────────────────

# ── Cloudflare Worker D1 (obligatorio) ──────
VITE_WORKER_URL=https://siso-api.dr-juliancucalon.workers.dev
VITE_WORKER_TOKEN=tu_token_aqui

# ── Supabase (backup legacy, puede quedar vacío) ──
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ── Dominio estable para links públicos ─────
VITE_STABLE_DOMAIN=https://ocupasaludparadesplegar.pages.dev

# ── IA Providers (opcionales) ───────────────
VITE_GEMINI_KEY=tu_gemini_api_key
VITE_GROQ_KEY=tu_groq_api_key
VITE_OPENROUTER_KEY=tu_openrouter_api_key
VITE_TOGETHER_KEY=tu_together_api_key

# ── Email (EmailJS) ──────────────────────────
VITE_EMAILJS_SERVICE_ID=service_xxx
VITE_EMAILJS_TEMPLATE_ID=template_xxx
VITE_EMAILJS_PUBLIC_KEY=tu_public_key

# ── GitHub Actions secrets (NO van en .env) ─
# CF_API_TOKEN       → Cloudflare API token para deploy Worker
# CF_ACCOUNT_ID      → Cloudflare Account ID
# CF_PAGES_PROJECT   → Nombre del proyecto CF Pages
